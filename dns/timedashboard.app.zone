; Cloudflare import for GitHub Pages. Checked 2026-10-15.
; Set the Pages custom domain to timedashboard.app before importing.
; Import with DNS only; explicit cf-proxied:false tags preserve this.
$ORIGIN timedashboard.app.
$TTL 300

timedashboard.app. 300 IN A 185.199.108.153 ; cf_tags=cf-proxied:false
timedashboard.app. 300 IN A 185.199.109.153 ; cf_tags=cf-proxied:false
timedashboard.app. 300 IN A 185.199.110.153 ; cf_tags=cf-proxied:false
timedashboard.app. 300 IN A 185.199.111.153 ; cf_tags=cf-proxied:false

timedashboard.app. 300 IN AAAA 2606:50c0:8000::153 ; cf_tags=cf-proxied:false
timedashboard.app. 300 IN AAAA 2606:50c0:8001::153 ; cf_tags=cf-proxied:false
timedashboard.app. 300 IN AAAA 2606:50c0:8002::153 ; cf_tags=cf-proxied:false
timedashboard.app. 300 IN AAAA 2606:50c0:8003::153 ; cf_tags=cf-proxied:false

www.timedashboard.app. 300 IN CNAME shaztechio.github.io. ; cf_tags=cf-proxied:false
